perm.test.pvalues <- c()
for(i in nrow(simulation.list.cleaned.combined.sub.numeric)){
# get the O/E for the simulation
sim.log2fc <- log2((simulation.list.cleaned.combined.sub.numeric.mean) / (simulation.list.cleaned.combined.sub.numeric[i, 1]))
obs.log2fc <- log2((observed.sub.numeric) / (simulation.list.cleaned.combined.sub.numeric.mean))
perm.test.pvalues[i] <- mean(abs(sim.log2fc) >= abs(obs.log2fc), na.rm = TRUE)
}
perm.test.pvalues
for(i in 1:nrow(simulation.list.cleaned.combined.sub.numeric)){
# get the O/E for the simulation
sim.log2fc <- log2((simulation.list.cleaned.combined.sub.numeric.mean) / (simulation.list.cleaned.combined.sub.numeric[i, 1]))
obs.log2fc <- log2((observed.sub.numeric) / (simulation.list.cleaned.combined.sub.numeric.mean))
perm.test.pvalues[i] <- mean(abs(sim.log2fc) >= abs(obs.log2fc), na.rm = TRUE)
}
perm.test.pvalues
