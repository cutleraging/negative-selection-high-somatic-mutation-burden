pattern <- paste0("^\\", mod_label)
} else {
# Look for precedingAA(UniMod:255), e.g. K(UniMod:255)
pattern <- paste0(precedingAA, "\\", mod_label)
}
data %>%
group_by(across(all_of(sample_col))) %>%
summarise(
total_peptides = n(),
mod_peptides   = sum(grepl(pattern, .data[[peptide_col]])),
.groups        = "drop"
) %>%
mutate(
fraction_mod = mod_peptides / total_peptides
)
}
