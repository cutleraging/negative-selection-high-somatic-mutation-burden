library(arrow)
count_mod_peptides <- function(data,
mod_label = "(UniMod:255)",
precedingAA = "N-term",
sample_col = "Sample",
peptide_col = "Peptide") {
# Create the regex pattern depending on whether mod is at N-term or on some AA
if (precedingAA == "N-term") {
# Look for the modification right at the start of the peptide:
# ^\(UniMod:255\) means it must start with (UniMod:255)
pattern <- paste0("^\\", mod_label)
} else {
# Look for precedingAA(UniMod:255), e.g. K(UniMod:255)
pattern <- paste0(precedingAA, "\\", mod_label)
}
# dplyr approach
library(dplyr)
data %>%
group_by(across(all_of(sample_col))) %>%
summarise(
total_peptides = n(),
mod_peptides   = sum(grepl(pattern, .data[[peptide_col]])),
.groups        = "drop"
) %>%
mutate(
fraction_mod = mod_peptides / total_peptides
)
}
