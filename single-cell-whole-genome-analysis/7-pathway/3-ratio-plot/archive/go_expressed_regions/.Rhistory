go_expressed_shuffled_regions_levels <- unique(go_expressed_shuffled$region)
go_expressed_shuffled_regions <- merge(go_expressed_shuffled, sample_table, by = "sample")
go_expressed_shuffled_regions$region <- factor(go_expressed_shuffled_regions$region, go_expressed_shuffled_regions_levels)
go_expressed_shuffled_regions <- subset(go_expressed_shuffled_regions, condition == "enu")
go_expressed_shuffled_regions_ratio_significance <- ratio_significance_pathway(go_expressed_shuffled_regions,
"condition",
go_expressed_shuffled_regions_levels)
# summarize by getting average log2fc for each group and then compare groups
go_expressed_shuffled_regions_summary <- subset(go_expressed_shuffled_regions) %>%
group_by(region, condition) %>%
summarise(median_log2fc = median(log2fc, na.rm = TRUE),
median.obs.mut = median(obs.mut, na.rm = TRUE))
