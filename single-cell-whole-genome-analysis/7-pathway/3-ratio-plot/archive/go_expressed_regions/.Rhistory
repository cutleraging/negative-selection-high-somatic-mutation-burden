go_expressed_shuffled_regions_summary$gene_length <- unlist(lapply(strsplit(go_expressed_shuffled_regions_summary$genes, "/"), length))
# add p-value correction
go_expressed_shuffled_regions_summary$pvalue.adjust <- p.adjust(go_expressed_shuffled_regions_summary$pvalue, method = "BH")
# filter out genes with 0 median obs mutations
go_expressed_shuffled_regions_summary <- go_expressed_shuffled_regions_summary %>%
filter(median.obs.mut >= 1)
