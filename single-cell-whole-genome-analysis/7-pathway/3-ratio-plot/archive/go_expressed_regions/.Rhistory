# load granges and results of enrichments
go_expressed_granges <- readRDS("go.expressed.RDS")
enrich.go_expressed <- readRDS("enrich.go.expressed.RDS")
# filter significant hits in real based on shuffle
go_expressed_regions_summary_sig <- go_expressed_regions_summary_sig %>%
filter(!GO.ID %in% go_expressed_shuffled_regions_summary_sig$GO.ID)
# filter for sig hits
go_expressed_granges_sig <- go_expressed_granges[names(go_expressed_granges) %in% go_expressed_regions_summary_sig$region]
enrich.go_expressed.sig <- filter(enrich.go_expressed, ID %in% go_expressed_regions_summary_sig$GO.ID)
# get sequence length distribution and add to results
lengths <- unlist(lapply(go_expressed_granges_sig, function(x) sum(width(x))))
go_expressed_regions_summary_sig$sequence_length <- lengths[match(go_expressed_regions_summary_sig$region, names(lengths))]
setwd("/Users/ronaldcutler/Dropbox\ (EinsteinMed)/Vijg-lab/Projects/mutation\ accumulation/231009\ multiple\ ENU\ analysis/6-pathway-overlap/3-ratio-plot/go_expressed_regions")
edox <- pairwise_termsim(enrich.go_expressed.sig)
pdf("enu_ratio_sig_filtered_tree.pdf",
width = 10,
height = 10)
treeplot(edox)
dev.off()
# using all go terms too complicated
# pdf("enu_ratio_sig_filtered_cnet.pdf",
#     width = 10,
#     height = 10)
# cnetplot(edox,
#          showCategory = 5)
# dev.off()
get shared genes amongst significant go terms
genelist <- strsplit(go_expressed_regions_summary_sig$genes, "/")
names(genelist) <- go_expressed_regions_summary_sig$region
genelist <- fromList(genelist)
genelist.reduced <- genelist[rowSums(genelist[, names(genelist)]) > 1,] # filter out sets with no overlap between others
pdf("enu_ratio_sig_filtered_upset.pdf",
width = 8,
height = 5)
upset(genelist.reduced,
nsets	= 10,
nintersects = NA,
order.by = "freq",
show.numbers = FALSE)
dev.off()
save
write.csv(go_expressed_regions_summary_sig, "enu_ratio_results_filtered.csv", row.names = FALSE)
# plot bar plot of significant hits
go_expressed_regions_summary_sig <- go_expressed_regions_summary_sig[order(go_expressed_regions_summary_sig$median_log2fc, decreasing = TRUE),]
go_expressed_regions_summary_sig$region <- factor(go_expressed_regions_summary_sig$region, levels = go_expressed_regions_summary_sig$region)
pdf("enu_ratio_sig_filtered_bar.pdf",
width = 8,
height = 5)
ggplot(go_expressed_regions_summary_sig[1:16,], aes(x = region, y = median_log2fc, fill = pvalue.adjust)) +
geom_bar(stat = "identity") +
scale_y_reverse() +
coord_flip() +
scale_fill_viridis() +
theme_Publication() +
theme(legend.justification = c("right","top"),
legend.position = "top",
legend.title = element_text(size=15),
legend.text = element_text(size=10),
axis.title.x = element_text(size = 12)) +
labs(x = "GO Biological Process",
y = "Mean Log2(observed/expected)\nSNVs Per Cell",
fill = "Adjusted p-value")
dev.off()
