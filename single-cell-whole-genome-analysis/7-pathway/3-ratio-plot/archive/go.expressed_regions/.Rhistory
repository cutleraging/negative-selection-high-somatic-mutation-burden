setwd("/Users/ronaldcutler/Dropbox\ (EinsteinMed)/Vijg-lab/Projects/mutation\ accumulation/231009\ multiple\ ENU\ analysis/6-pathway-overlap/1-load-data")
# filter significant hits in real based on shuffle
go.expressed_regions_combined_summary.sig <- go.expressed_regions_combined_summary.sig %>%
filter(!GO.ID %in% go.expressed.shuffled_regions_combined_summary.sig$GO.ID)
# granges
go.expressed <- readRDS("go.expressed.RDS")
# enrichment results
enrich.go.expressed <- readRDS("enrich.go.expressed.RDS")
# filter for sig hits
go.expressed.sig <- go.expressed[names(go.expressed) %in% go.expressed_regions_combined_summary.sig$region]
enrich.go.expressed.sig <- filter(enrich.go.expressed, ID %in% go.expressed_regions_combined_summary.sig$GO.ID)
# get sequence length distribution and add to results
lengths <- unlist(lapply(go.expressed.sig, function(x) sum(width(x))))
go.expressed_regions_combined_summary.sig$sequence_length <- lengths[match(go.expressed_regions_combined_summary.sig$region, names(lengths))]
setwd("/Users/ronaldcutler/Dropbox\ (EinsteinMed)/Vijg-lab/Projects/mutation\ accumulation/231009\ multiple\ ENU\ analysis/6-pathway-overlap/3-ratio-plot/go.expressed_regions")
genelist <- strsplit(go.expressed_regions_combined_summary.sig$genes, "/")
names(genelist) <- go.expressed_regions_combined_summary.sig$region
genelist <- fromList(genelist)
genelist.reduced <- genelist[rowSums(genelist[, names(genelist)]) > 1,] # filter out sets with no overlap between others
pdf("enu_ratio_sig_filtered_upset.pdf",
width = 8,
height = 5)
upset(genelist.reduced,
nsets	= 10,
nintersects = NA,
order.by = "freq",
show.numbers = FALSE)
dev.off()
# save
write.csv(go.expressed_regions_combined_summary.sig, "enu_ratio_sig_filtered.csv", row.names = FALSE)
# plot bar plot of significant hits
go.expressed_regions_combined_summary.sig <- go.expressed_regions_combined_summary.sig[order(go.expressed_regions_combined_summary.sig$average_log2fc, decreasing = TRUE),]
go.expressed_regions_combined_summary.sig$region <- factor(go.expressed_regions_combined_summary.sig$region, levels = go.expressed_regions_combined_summary.sig$region)
pdf("enu_ratio_sig_filtered_bar.pdf",
width = 8,
height = 5)
ggplot(go.expressed_regions_combined_summary.sig[1:16,], aes(x = region, y = average_log2fc, fill = pvalue.adjust)) +
geom_bar(stat = "identity") +
scale_y_reverse() +
coord_flip() +
scale_fill_viridis() +
theme_Publication() +
theme(legend.justification = c("right","top"),
legend.position = "top",
legend.title = element_text(size=15),
legend.text = element_text(size=10),
axis.title.x = element_text(size = 12)) +
labs(x = "GO Biological Process",
y = "Mean Log2(observed/expected)\nSNVs Per Cell",
fill = "Adjusted p-value")
library(ggplot2)
library(stringr)
library(dplyr)
library(ggpubr)
library(purrr)
library(rstatix)
library(EnhancedVolcano)
library(clusterProfiler)
library(enrichplot)
library(UpSetR)
library(viridis)
hg19_size <- 3036303846
# plot bar plot of significant hits
go.expressed_regions_combined_summary.sig <- go.expressed_regions_combined_summary.sig[order(go.expressed_regions_combined_summary.sig$average_log2fc, decreasing = TRUE),]
go.expressed_regions_combined_summary.sig$region <- factor(go.expressed_regions_combined_summary.sig$region, levels = go.expressed_regions_combined_summary.sig$region)
pdf("enu_ratio_sig_filtered_bar.pdf",
width = 8,
height = 5)
ggplot(go.expressed_regions_combined_summary.sig[1:16,], aes(x = region, y = average_log2fc, fill = pvalue.adjust)) +
geom_bar(stat = "identity") +
scale_y_reverse() +
coord_flip() +
scale_fill_viridis() +
theme_Publication() +
theme(legend.justification = c("right","top"),
legend.position = "top",
legend.title = element_text(size=15),
legend.text = element_text(size=10),
axis.title.x = element_text(size = 12)) +
labs(x = "GO Biological Process",
y = "Mean Log2(observed/expected)\nSNVs Per Cell",
fill = "Adjusted p-value")
dev.off()
# bar plot of number of increased estimated mutations
bar_plot <- subset(go.expressed_regions_combined, group == "observed") %>%
mutate(est.mut = obs.mut / Cov / Sen_SNV * hg19_size) %>%
group_by(region, condition) %>%
summarise(mean.est.mut = mean(est.mut, na.rm = TRUE)) %>%
group_by(region) %>%
spread(key = condition, value = mean.est.mut) %>%
mutate(group_diff = abs(enu - control)) %>%
filter(region %in% go.expressed_regions_combined_summary.sig[1:16,]$region)
bar_plot <- bar_plot[match(go.expressed_regions_combined_summary.sig[1:16,]$region, bar_plot$region),]
bar_plot$region <- factor(bar_plot$region, levels = bar_plot$region)
bar_plot$group_diff
pdf("enu_number_sig_filtered_bar.pdf",
width = 8,
height = 4.5)
ggplot(bar_plot, aes(x = region, y = group_diff)) +
geom_bar(stat = "identity") +
coord_flip() +
theme_Publication() +
theme(
axis.title.x = element_text(size = 12)) +
labs(x = "GO Biological Process",
y = "Mean Estimated SNV increase\nin ENU-treated cells")
dev.off()
bar_plot
colMeans(bar_plot)
colMeans(bar_plot[,-1])
sd(bar_plot$group_diff)
bar_plot$enu / bar_plot$control
mean(bar_plot$enu / bar_plot$control)
log2(mean(bar_plot$enu / bar_plot$control))
sd(bar_plot$group_diff)
