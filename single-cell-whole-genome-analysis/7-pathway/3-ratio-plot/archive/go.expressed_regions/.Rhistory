# kegg
# observed
kegg.expressed_regions <- read.csv("kegg.expressed_regions_res_snv.csv", header = TRUE, row.names = NULL)
# downsample
kegg.expressed_regions_downsample <- read.csv("kegg.expressed_regions_res_downsample_snv.csv", header = TRUE, row.names = NULL)
# kegg shuffle
# observed
kegg.expressed.shuffled_regions <- read.csv("kegg.expressed.shuffled_regions_res_snv.csv", header = TRUE, row.names = NULL)
# downsample
kegg.expressed.shuffled_regions_downsample <- read.csv("kegg.expressed.shuffled_regions_res_downsample_snv.csv", header = TRUE, row.names = NULL)
dir.create("/Users/ronaldcutler/Dropbox\ (EinsteinMed)/Vijg-lab/Projects/mutation\ accumulation/231009\ multiple\ ENU\ analysis/6-pathway-overlap/3-ratio-plot/go.expressed_regions")
setwd("/Users/ronaldcutler/Dropbox\ (EinsteinMed)/Vijg-lab/Projects/mutation\ accumulation/231009\ multiple\ ENU\ analysis/6-pathway-overlap/3-ratio-plot/go.expressed_regions")
go.expressed_regions_levels <- unique(go.expressed_regions$region)
go.expressed_regions_combined <- combine_observed_downsampled(go.expressed_regions,
go.expressed_regions_downsample,
go.expressed_regions_levels,
sample_table)
go.expressed_regions_ratio_significance <- ratio_significance_go(go.expressed_regions_combined,
"condition",
go.expressed_regions_levels)
# summarize by getting average log2fc for each group and then compare groups
go.expressed_regions_combined_summary <- subset(go.expressed_regions_combined, group == "observed" & condition == "enu") %>%
group_by(region, condition) %>%
summarise(average_log2fc = mean(log2fc, na.rm = TRUE),
median.obs.mut = median(obs.mut, na.rm = TRUE))
# add significance values
go.expressed_regions_combined_summary <- merge(go.expressed_regions_combined_summary,
subset(go.expressed_regions_ratio_significance, group == "observed" & condition == "enu"),
by = "region")
# add GO IDs
go.expressed_regions_combined_summary$GO.ID <- go_ids$ID[match(go.expressed_regions_combined_summary$region, go_ids$Description)]
# add size of gene set
go.expressed_regions_combined_summary$genes <- go_ids$geneID[match(go.expressed_regions_combined_summary$region, go_ids$Description)]
go.expressed_regions_combined_summary$gene_length <- unlist(lapply(strsplit(go.expressed_regions_combined_summary$genes, "/"), length))
# add p-value correction
go.expressed_regions_combined_summary$pvalue.adjust <- p.adjust(go.expressed_regions_combined_summary$pvalue, method = "BH")
# filter out genes with 0 median obs mutations
go.expressed_regions_combined_summary <- go.expressed_regions_combined_summary %>%
filter(median.obs.mut >= 1)
# get significant hits
go.expressed_regions_combined_summary.sig <- go.expressed_regions_combined_summary %>%
filter(pvalue.adjust <= 0.05)
# enu vs control
write.csv(go.expressed_regions_combined_summary, "enu_ratio_sig.csv", row.names = FALSE)
