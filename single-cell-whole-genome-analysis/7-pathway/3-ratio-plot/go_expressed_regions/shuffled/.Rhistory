legend.text = element_text(size = 10),  # Adjust legend text size
legend.title = element_text(size = 12))  # Adjust legend title size
pdf("enu_violin_oe_norm.pdf",
width = 4,
height = 5)
ggplot(subset(go_expressed_regions_exons_promoters_enhancers_shuffled_avg_summary_norm,
condition == "enu"), aes(x = condition, y = log2fc.norm, fill = as.factor(cycle))) +
geom_hline(yintercept = 0, linetype = "dashed") +
geom_violin(position = position_dodge(width = 0.85), scale = "width", width = 0.75, draw_quantiles = c(0.5)) +
geom_jitter(
data = subset(go_expressed_regions_exons_promoters_enhancers_shuffled_avg_summary_norm,
condition == "enu"),
aes(shape = observed.variant.requirement.met,
group = interaction(condition, cycle),
alpha = jitter_alpha),
size = 1.5,
position = position_jitterdodge(jitter.width = 0.3, dodge.width = 0.85),
show.legend = FALSE  # optional if alpha legend not needed
) +
