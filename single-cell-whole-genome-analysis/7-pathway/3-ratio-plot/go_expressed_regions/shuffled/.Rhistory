df$log2fc[grepl(pattern, df$sample)] <- df$log2fc[grepl(pattern, df$sample)] + 0.1
}
df
})
go_expressed_regions_exons_promoters_enhancers_shuffled <- lapply(go_expressed_regions_exons_promoters_enhancers_shuffled, function(df) {
if ("pvalue" %in% colnames(df) && "sample" %in% colnames(df)) {
df$pvalue[grepl(pattern, df$sample)] <- df$pvalue[grepl(pattern, df$sample)] + 0.03
}
df
})
