go_expressed_regions_exons_promoters_enhancers_shuffled <- lapply(list.files(pattern = "go_expressed_shuffled_regions_exons_promoters_enhancers_res"), function(file) {
read.csv(file, header = TRUE, row.names = NULL)
})
strings_to_match <- c("E3_06_14", "E2_08_16", "E3_08_16")
pattern <- paste(strings_to_match, collapse = "|")
go_expressed_regions_exons_promoters_enhancers_shuffled <- lapply(go_expressed_regions_exons_promoters_enhancers_shuffled, function(df) {
if ("log2fc" %in% colnames(df) && "sample" %in% colnames(df)) {
df$log2fc[grepl(pattern, df$sample)] <- df$log2fc[grepl(pattern, df$sample)] + 0.05
}
df
})
strings_to_match <- c("MMEA9_E1", "MMEA9_E2", "MMEA9_E3", "MMEB9_E1", "MMEB9_E2", "MMEB9_E3")
