ggplot(go_expressed_regions_exons_promoters_enhancers_shuffled_avg_summary,
aes(x = condition, y = obs.mut.mean, fill = as.factor(cycle))) +
geom_violin(position = position_dodge(width = 0.85),
scale = "width", width = 0.75, draw_quantiles = c(0.5)) +
geom_jitter(aes(color = observed.variant.requirement.met,
group = interaction(condition, cycle)),
size = 1, alpha = 0.5,
position = position_jitterdodge(jitter.width = 0.15, dodge.width = 0.9)) +
scale_color_manual(values = c("TRUE" = "red", "FALSE" = "black")) +
guides(fill = guide_legend(order = 1, override.aes = list(shape = NA)),
color = guide_legend(order = 2)) +
labs(x = "", y = "Mean Observed\nVariants Per Pathway", fill = "Cycle",
color = "Observed Variant\nCount Sufficient?") +
scale_fill_viridis(discrete = TRUE, end = 0.8) +
theme_Publication() +
theme(legend.position = "top", legend.box = "vertical") +
scale_x_discrete(labels = c("Control", "ENU"))
dev.off()
