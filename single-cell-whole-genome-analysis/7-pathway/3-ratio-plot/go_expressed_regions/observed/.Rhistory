width = 4,
height = 5)
ggplot(subset(go_expressed_regions_exons_promoters_enhancers_summary,
condition == "control"), aes(x = condition, y = log2fc.mean, fill = as.factor(cycle))) +
geom_hline(yintercept = 0, linetype = "dashed") +
geom_violin(position = position_dodge(width = 0.85), scale = "width", width = 0.75, draw_quantiles = c(0.5)) +
geom_jitter(aes(color = p_adjusted,
shape = observed.variant.requirement.met,
group = interaction(condition, cycle)), size = 2, alpha = 0.5,
position = position_jitterdodge(jitter.width = 0.3, dodge.width = 0.85)) +
guides(fill = guide_legend(override.aes = list(shape = NA))) +
labs(x = "Control Cells",
y = expression(bold(atop(Log[2] * "(Observed / Expected)", "SNVs Per Pathway"))),
fill = "Cycle",
color = "Adjusted p-value",
shape = "Observed Variant\nCount Sufficient?") +
scale_fill_viridis(discrete = TRUE, end = 0.8) +
scale_color_gradientn(colors = c("red", "black"),
limits = c(min(go_expressed_regions_exons_promoters_enhancers_summary$p_value),
max(go_expressed_regions_exons_promoters_enhancers_summary$p_value))) +
scale_shape_manual(values = c(`TRUE` = 16, `FALSE` = 15),
labels = c(`TRUE` = "True", `FALSE` = "False")) +
theme_Publication() +
theme(legend.position = "top",  # Place legend on the top
legend.box = "vertical",
axis.text.x = element_blank(),
axis.ticks.x = element_blank(),
legend.text = element_text(size = 10),  # Adjust legend text size
legend.title = element_text(size = 12))  # Adjust legend title size
