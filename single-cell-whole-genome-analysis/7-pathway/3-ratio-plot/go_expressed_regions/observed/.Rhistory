ggplot(go_expressed_regions_exons_promoters_enhancers_summary, aes(x = condition, y = log2fc.mean, fill = as.factor(cycle))) +
geom_hline(yintercept = 0, linetype = "dashed") +
geom_violin(position = position_dodge(width = 0.85), scale = "width", width = 0.75, draw_quantiles = c(0.5)) +
geom_jitter(aes(color = p_adjusted), size = 1, alpha = 0.5, position = position_jitterdodge(jitter.width = 0.15, dodge.width = 0.85)) +
guides(fill = guide_legend(override.aes = list(shape = NA))) +
labs(x = "",
y = expression(bold(atop(Log[2] * "(Observed / Expected)", "SNVs Per Pathway"))),
fill = "Cycle", color = "Adjusted p-value") +
scale_fill_viridis(discrete = TRUE, end = 0.8) +
scale_color_gradientn(colors = c("red", "black"),
limits = c(min(go_expressed_regions_exons_promoters_enhancers_summary$p_value),
max(go_expressed_regions_exons_promoters_enhancers_summary$p_value))) +
theme_Publication() +
theme(legend.position = "none",  # Place legend on the top
legend.box = "vertical") +  # Stack legend items horizontally
scale_y_continuous(breaks = seq(-2, 2, 1), lim = c(-2, 1.5)) +
scale_x_discrete(labels = c("Control", "ENU"))
dev.off()
