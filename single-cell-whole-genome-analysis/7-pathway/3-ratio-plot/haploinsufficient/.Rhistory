geom_boxplot(outlier.shape = NA) +
geom_point(size = 2, alpha = 0.5, position = position_dodge(width = 0.75)) +
guides(fill = guide_legend(override.aes = list(shape = NA))) +
labs(x = "",
y = expression(bold(atop(Log[2] * "(Observed / Expected)", "SNVs Per Cell"))),
fill = "Cycle") +
scale_fill_viridis(discrete = TRUE, end = 0.8) +
theme_Publication() +
theme(legend.position = "top",  # Place legend on the right side
legend.box = "horizontal",  # Stack legend items vertically
legend.text = element_text(size = 10),  # Adjust legend text size
legend.title = element_text(size = 12)) +  # Adjust legend title size
scale_y_continuous(breaks = c(-1, 0, 1), lim = c(-1, 1)) +
scale_x_discrete(labels = c("Control", "ENU")) +
facet_grid(.~region, labeller = labeller(region = labels))
dev.off()
# ratio by group
stats_summary <- haplo_genes_no_introns_res_norm %>%
group_by(condition, cycle, region) %>%
summarise(mean = mean(log2fc.norm, na.rm = TRUE),
sd = sd(log2fc.norm, na.rm = TRUE),
observed.variant.requirement.met = sum(observed.variant.requirement.met, na.rm = TRUE) / n() > 0.5)
stats_summary$observed.variant.requirement.met <- factor(stats_summary$observed.variant.requirement.met,
levels = c(TRUE, FALSE))
write.csv(stats_summary, "haplo_genes_no_introns_res_norm_group.csv")
pdf("haplo_genes_no_introns_res_norm_control.pdf",
width = 4.5,
height = 4)
ggplot(subset(stats_summary, condition == "control"), aes(x = condition, y = mean, color = as.factor(cycle), shape = observed.variant.requirement.met)) +
geom_hline(yintercept = 0, linetype = "dashed") +
geom_pointrange(aes(ymin=mean - sd, ymax=mean + sd),
position=position_dodge(width = 0.7),
size = 1.1) +
guides(color = guide_legend(override.aes = list(shape = 16, size = 0.75), order = 1),
shape = guide_legend(override.aes = list(size = 0.75)), order = 2) +
scale_color_viridis(discrete = TRUE, end = 0.8) +
scale_shape_manual(values = c(`TRUE` = 16, `FALSE` = 15),
labels = c(`TRUE` = "True", `FALSE` = "False")) +
labs(x = "Control Cells",
y = expression(bold(atop(Log[2] * "(Observed / Expected)", "Variants Per Cell"))),
color = "Cycle",
shape = "Observed Variant\nCount Sufficient?") +
theme_Publication() +
theme(legend.position = "top",  # Place legend on the right side
legend.box = "vertical",  # Stack legend items vertically
legend.text = element_text(size = 10),  # Adjust legend text size
legend.title = element_text(size = 12),
strip.text = element_text(size = 12),
axis.text.x = element_blank(),
axis.ticks.x = element_blank()) +  # Adjust legend title size
facet_grid(.~region, labeller = labeller(region = labels))
dev.off()
pdf("haplo_genes_no_introns_res_norm_enu.pdf",
width = 4.5,
height = 4)
ggplot(subset(stats_summary, condition == "enu"), aes(x = condition, y = mean, color = as.factor(cycle), shape = observed.variant.requirement.met)) +
geom_hline(yintercept = 0, linetype = "dashed") +
geom_pointrange(aes(ymin=mean - sd, ymax=mean + sd),
position=position_dodge(width = 0.7),
size = 1.1) +
guides(color = guide_legend(override.aes = list(shape = 16, size = 0.75), order = 1),
shape = guide_legend(override.aes = list(size = 0.75)), order = 2) +
scale_color_viridis(discrete = TRUE, begin = 0.2, end = 0.8) +
scale_shape_manual(values = c(`TRUE` = 16, `FALSE` = 15),
labels = c(`TRUE` = "True", `FALSE` = "False")) +
labs(x = "ENU-Treated Cells",
y = expression(bold(atop(Log[2] * "(Observed / Expected)", "Variants Per Cell"))),
color = "Cycle",
shape = "Observed Variant\nCount Sufficient?") +
theme_Publication() +
theme(legend.position = "top",  # Place legend on the right side
legend.box = "vertical",  # Stack legend items vertically
legend.text = element_text(size = 10),  # Adjust legend text size
legend.title = element_text(size = 12),
strip.text = element_text(size = 12),
axis.text.x = element_blank(),
axis.ticks.x = element_blank()) +  # Adjust legend title size
facet_grid(.~region, labeller = labeller(region = labels))
dev.off()
