"Essential")
names(labels) <- levels(AchillesCommonEssentialNonessentialControls_no_introns_res_norm$region)
# ratio by cell
pdf("AchillesCommonEssentialNonessentialControls_no_introns_res_norm_cells.pdf",
width = 4.5,
height = 4)
ggplot(AchillesCommonEssentialNonessentialControls_no_introns_res_norm, aes(x = condition, y = log2fc.norm, fill = as.factor(cycle))) +
geom_hline(yintercept = 0, linetype = "dashed") +
geom_boxplot(outlier.shape = NA) +
geom_point(size = 2, alpha = 0.5, position = position_dodge(width = 0.75)) +
guides(fill = guide_legend(override.aes = list(shape = NA))) +
